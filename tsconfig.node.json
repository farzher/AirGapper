{
  // Typechecks the node-context code the main tsconfig doesn't reach: the
  // build plugins and vite.config.ts. DOM stays in lib because the config
  // imports shared/ modules (protocol, snippet) that use web APIs — which
  // node ≥18 actually has at runtime.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["build", "vite.config.ts"]
}
