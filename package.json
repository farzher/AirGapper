{
  "name": "airgapper",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "Offline file and text transfer using fountain-coded animated QR codes.",
  "type": "module",
  "scripts": {
    "dev": "vite --open /app.html",
    "serve": "npm run build && vite preview",
    "diagnostics": "vite --mode diagnostics --open /app.html",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "build:standalone": "npm run build && node scripts/copy-standalone.mjs",
    "build:all": "npm run build:standalone",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/pwa-smoke.mjs",
    "test:codec": "node scripts/test-codec.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "build:codec": "bash vendor/decimen-codec-source/build.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "qrcode": "^1.5.4",
    "tsx": "4.20.6",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
